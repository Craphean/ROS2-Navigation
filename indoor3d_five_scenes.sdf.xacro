<?xml version="1.0" encoding="UTF-8"?>
<!--
  FIVE INDOOR GAZEBO WORLDS IN ONE FILE
  Upload this file directly to the GitHub repository's worlds/ directory.
  No extra models or scene files are required.
  Default scene: classroom.
  To change scene, set INDOOR_SCENE to one of:
    classroom, library, office, computer_lab, campus_corridor
  Example: INDOOR_SCENE=library xacro this_file.sdf.xacro headless:=True > /tmp/library.sdf
  Spawns (x, y, yaw), in metres/radians:
  classroom:       R1=(-6.25,-4.00,0), R2=(6.25,-4.00,3.14159)
  library:         R1=(-7.00,-5.00,0), R2=(7.00,-5.00,3.14159)
  office:          R1=(-6.80, 0.00,0), R2=(6.80, 0.00,3.14159)
  computer_lab:    R1=(-7.05,-4.90,0), R2=(7.05,-4.90,3.14159)
  campus_corridor: R1=(-8.70, 0.00,0), R2=(8.70, 0.00,3.14159)
  All geometry has visual meshes and static collision geometry. 
  The maps have been checked for XML structure and geometric connectivity,
  but are not yet verified in a running Gazebo/ROS2 environment.
-->
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>
  <xacro:property name="selected_scene" value="$(optenv INDOOR_SCENE classroom)"/>
  <xacro:if value="${selected_scene == 'classroom'}">
    <world name="eval_classroom">
      <scene><grid>false</grid><shadows>false</shadows></scene>
      <physics name="1ms" type="ode">
        <max_step_size>0.003</max_step_size><real_time_update_rate>1000.0</real_time_update_rate>
        <real_time_factor>1.0</real_time_factor>
      </physics>
      <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
      <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
      <xacro:unless value="$(arg headless)">
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
      </xacro:unless>
      <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
      <light name="sun" type="directional">
        <cast_shadows>0</cast_shadows><pose>0 0 9 0 0 0</pose>
        <diffuse>0.90 0.90 0.90 1</diffuse><specular>0.2 0.2 0.2 1</specular>
        <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
        <direction>-0.2 0.1 -0.95</direction>
      </light>
      <model name="ground_plane">
        <static>true</static><link name="ground_link">
          <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
            <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface></collision>
          <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
            <material><ambient>0.89 0.91 0.93 1</ambient><diffuse>0.89 0.91 0.93 1</diffuse></material></visual>
        </link>
      </model>
      <!-- One static link contains all furniture and wall colliders to reduce simulated entities. -->
      <model name="architecture_and_furniture">
        <static>true</static>
        <link name="geometry">
          <collision name="north_wall_collision">
            <pose>0.0000 5.0000 0.9000 0 0 0</pose>
            <geometry><box><size>14.2000 0.1800 1.8000</size></box></geometry>
            
          </collision>
          <visual name="north_wall_visual">
            <pose>0.0000 5.0000 0.9000 0 0 0</pose>
            <geometry><box><size>14.2000 0.1800 1.8000</size></box></geometry>
            <material><ambient>0.8800 0.9000 0.9300 1</ambient><diffuse>0.8800 0.9000 0.9300 1</diffuse></material>
          </visual>
          <collision name="south_wall_collision">
            <pose>0.0000 -5.0000 0.9000 0 0 0</pose>
            <geometry><box><size>14.2000 0.1800 1.8000</size></box></geometry>
            
          </collision>
          <visual name="south_wall_visual">
            <pose>0.0000 -5.0000 0.9000 0 0 0</pose>
            <geometry><box><size>14.2000 0.1800 1.8000</size></box></geometry>
            <material><ambient>0.8800 0.9000 0.9300 1</ambient><diffuse>0.8800 0.9000 0.9300 1</diffuse></material>
          </visual>
          <collision name="west_wall_collision">
            <pose>-7.0000 0.0000 0.9000 0 0 0</pose>
            <geometry><box><size>0.1800 10.2000 1.8000</size></box></geometry>
            
          </collision>
          <visual name="west_wall_visual">
            <pose>-7.0000 0.0000 0.9000 0 0 0</pose>
            <geometry><box><size>0.1800 10.2000 1.8000</size></box></geometry>
            <material><ambient>0.8800 0.9000 0.9300 1</ambient><diffuse>0.8800 0.9000 0.9300 1</diffuse></material>
          </visual>
          <collision name="east_wall_collision">
            <pose>7.0000 0.0000 0.9000 0 0 0</pose>
            <geometry><box><size>0.1800 10.2000 1.8000</size></box></geometry>
            
          </collision>
          <visual name="east_wall_visual">
            <pose>7.0000 0.0000 0.9000 0 0 0</pose>
            <geometry><box><size>0.1800 10.2000 1.8000</size></box></geometry>
            <material><ambient>0.8800 0.9000 0.9300 1</ambient><diffuse>0.8800 0.9000 0.9300 1</diffuse></material>
          </visual>
          <collision name="student_1_1_top_collision">
            <pose>-5.1000 -1.5500 0.7400 0 0 0</pose>
            <geometry><box><size>1.1500 0.6600 0.0650</size></box></geometry>
            
