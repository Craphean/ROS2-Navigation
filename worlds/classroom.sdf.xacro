<?xml version="1.0"?>
<sdf version="1.6" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="true"/>

  <world name="classroom">
    <scene>
      <grid>false</grid>
      <shadows>false</shadows>
    </scene>

    <physics name="1ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <xacro:unless value="$(arg headless)">
      <plugin
        filename="gz-sim-scene-broadcaster-system"
        name="gz::sim::systems::SceneBroadcaster">
      </plugin>
    </xacro:unless>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <light name="classroom_light" type="directional">
      <cast_shadows>0</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.92 0.94 0.98 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.1 0.1 -0.98</direction>
    </light>

    <model name="classroom_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.80 0.78 0.72 1.0</ambient>
            <diffuse>0.80 0.78 0.72 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer shell: 16 m x 12 m, 2.8 m high. -->
    <model name="classroom_walls">
      <static>true</static>
      <link name="walls">
        <collision name="north"><pose>0 6.0 1.4 0 0 0</pose><geometry><box><size>16.2 0.2 2.8</size></box></geometry></collision>
        <visual name="north_vis"><pose>0 6.0 1.4 0 0 0</pose><geometry><box><size>16.2 0.2 2.8</size></box></geometry>
          <material><ambient>0.92 0.93 0.95 1</ambient><diffuse>0.92 0.93 0.95 1</diffuse></material></visual>
        <collision name="south"><pose>0 -6.0 1.4 0 0 0</pose><geometry><box><size>16.2 0.2 2.8</size></box></geometry></collision>
        <visual name="south_vis"><pose>0 -6.0 1.4 0 0 0</pose><geometry><box><size>16.2 0.2 2.8</size></box></geometry>
          <material><ambient>0.92 0.93 0.95 1</ambient><diffuse>0.92 0.93 0.95 1</diffuse></material></visual>
        <collision name="west"><pose>-8.0 0 1.4 0 0 0</pose><geometry><box><size>0.2 12.2 2.8</size></box></geometry></collision>
        <visual name="west_vis"><pose>-8.0 0 1.4 0 0 0</pose><geometry><box><size>0.2 12.2 2.8</size></box></geometry>
          <material><ambient>0.88 0.90 0.93 1</ambient><diffuse>0.88 0.90 0.93 1</diffuse></material></visual>
        <collision name="east"><pose>8.0 0 1.4 0 0 0</pose><geometry><box><size>0.2 12.2 2.8</size></box></geometry></collision>
        <visual name="east_vis"><pose>8.0 0 1.4 0 0 0</pose><geometry><box><size>0.2 12.2 2.8</size></box></geometry>
          <material><ambient>0.88 0.90 0.93 1</ambient><diffuse>0.88 0.90 0.93 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Whiteboard and teacher area. -->
    <model name="whiteboard">
      <static>true</static>
      <link name="board">
        <collision name="c"><pose>0 0 0 0 0 0</pose><geometry><box><size>6.0 0.08 1.4</size></box></geometry></collision>
        <visual name="v"><pose>0 0 0 0 0 0</pose><geometry><box><size>6.0 0.08 1.4</size></box></geometry>
          <material><ambient>0.95 0.97 0.97 1</ambient><diffuse>0.95 0.97 0.97 1</diffuse></material></visual>
      </link>
      <pose>0 5.84 1.7 0 0 0</pose>
    </model>

    <model name="teacher_desk">
      <static>true</static>
      <link name="desk">
        <collision name="top"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>2.6 0.85 0.08</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.75 0 0 0</pose><geometry><box><size>2.6 0.85 0.08</size></box></geometry>
          <material><ambient>0.48 0.30 0.18 1</ambient><diffuse>0.48 0.30 0.18 1</diffuse></material></visual>
        <collision name="left"><pose>-1.20 0 0.37 0 0 0</pose><geometry><box><size>0.08 0.80 0.75</size></box></geometry></collision>
        <visual name="left_vis"><pose>-1.20 0 0.37 0 0 0</pose><geometry><box><size>0.08 0.80 0.75</size></box></geometry>
          <material><ambient>0.38 0.24 0.14 1</ambient><diffuse>0.38 0.24 0.14 1</diffuse></material></visual>
        <collision name="right"><pose>1.20 0 0.37 0 0 0</pose><geometry><box><size>0.08 0.80 0.75</size></box></geometry></collision>
        <visual name="right_vis"><pose>1.20 0 0.37 0 0 0</pose><geometry><box><size>0.08 0.80 0.75</size></box></geometry>
          <material><ambient>0.38 0.24 0.14 1</ambient><diffuse>0.38 0.24 0.14 1</diffuse></material></visual>
      </link>
      <pose>0 4.35 0 0 0 0</pose>
    </model>

    <model name="teacher_chair">
      <static>true</static>
      <link name="chair">
        <collision name="seat"><pose>0 0 0.45 0 0 0</pose><geometry><box><size>0.48 0.48 0.08</size></box></geometry></collision>
        <visual name="seat_vis"><pose>0 0 0.45 0 0 0</pose><geometry><box><size>0.48 0.48 0.08</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
        <collision name="back"><pose>0 0.22 0.75 0 0 0</pose><geometry><box><size>0.48 0.06 0.55</size></box></geometry></collision>
        <visual name="back_vis"><pose>0 0.22 0.75 0 0 0</pose><geometry><box><size>0.48 0.06 0.55</size></box></geometry>
          <material><ambient>0.15 0.25 0.45 1</ambient><diffuse>0.15 0.25 0.45 1</diffuse></material></visual>
      </link>
      <pose>0 3.45 0 0 0 3.14</pose>
    </model>

    <!-- Student desks: 3 columns x 4 rows.  Tabletops are above 2D LiDAR height
         but visible in the 3D cloud, which exercises the 3D-aware planner. -->
    <xacro:macro name="student_desk" params="name x y">
      <model name="${name}">
        <static>true</static>
        <link name="desk">
          <collision name="top"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.45 0.68 0.06</size></box></geometry></collision>
          <visual name="top_vis"><pose>0 0 0.73 0 0 0</pose><geometry><box><size>1.45 0.68 0.06</size></box></geometry>
            <material><ambient>0.62 0.44 0.24 1</ambient><diffuse>0.62 0.44 0.24 1</diffuse></material></visual>
          <collision name="l1"><pose>-0.66 -0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
          <visual name="l1v"><pose>-0.66 -0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry>
            <material><ambient>0.35 0.32 0.30 1</ambient><diffuse>0.35 0.32 0.30 1</diffuse></material></visual>
          <collision name="l2"><pose>0.66 -0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
          <visual name="l2v"><pose>0.66 -0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry>
            <material><ambient>0.35 0.32 0.30 1</ambient><diffuse>0.35 0.32 0.30 1</diffuse></material></visual>
          <collision name="l3"><pose>-0.66 0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
          <visual name="l3v"><pose>-0.66 0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry>
            <material><ambient>0.35 0.32 0.30 1</ambient><diffuse>0.35 0.32 0.30 1</diffuse></material></visual>
          <collision name="l4"><pose>0.66 0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
          <visual name="l4v"><pose>0.66 0.28 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry>
            <material><ambient>0.35 0.32 0.30 1</ambient><diffuse>0.35 0.32 0.30 1</diffuse></material></visual>
        </link>
        <pose>${x} ${y} 0 0 0 0</pose>
      </model>
    </xacro:macro>

    <xacro:macro name="student_chair" params="name x y yaw">
      <model name="${name}">
        <static>true</static>
        <link name="chair">
          <collision name="seat"><pose>0 0 0.43 0 0 0</pose><geometry><box><size>0.46 0.46 0.07</size></box></geometry></collision>
          <visual name="seat_vis"><pose>0 0 0.43 0 0 0</pose><geometry><box><size>0.46 0.46 0.07</size></box></geometry>
            <material><ambient>0.18 0.38 0.55 1</ambient><diffuse>0.18 0.38 0.55 1</diffuse></material></visual>
          <collision name="back"><pose>0 0.21 0.73 0 0 0</pose><geometry><box><size>0.46 0.06 0.58</size></box></geometry></collision>
          <visual name="back_vis"><pose>0 0.21 0.73 0 0 0</pose><geometry><box><size>0.46 0.06 0.58</size></box></geometry>
            <material><ambient>0.18 0.38 0.55 1</ambient><diffuse>0.18 0.38 0.55 1</diffuse></material></visual>
        </link>
        <pose>${x} ${y} 0 0 0 ${yaw}</pose>
      </model>
    </xacro:macro>

    <xacro:student_desk name="desk_c1_r1" x="-4.5" y="1.20"/>
    <xacro:student_desk name="desk_c1_r2" x="-4.5" y="-0.60"/>
    <xacro:student_desk name="desk_c1_r3" x="-4.5" y="-2.40"/>
    <xacro:student_desk name="desk_c1_r4" x="-4.5" y="-4.20"/>
    <xacro:student_desk name="desk_c2_r1" x="0.0" y="1.20"/>
    <xacro:student_desk name="desk_c2_r2" x="0.0" y="-0.60"/>
    <xacro:student_desk name="desk_c2_r3" x="0.0" y="-2.40"/>
    <xacro:student_desk name="desk_c2_r4" x="0.0" y="-4.20"/>
    <xacro:student_desk name="desk_c3_r1" x="4.5" y="1.20"/>
    <xacro:student_desk name="desk_c3_r2" x="4.5" y="-0.60"/>
    <xacro:student_desk name="desk_c3_r3" x="4.5" y="-2.40"/>
    <xacro:student_desk name="desk_c3_r4" x="4.5" y="-4.20"/>

    <xacro:student_chair name="chair_c1_r1" x="-4.5" y="0.62" yaw="3.14"/>
    <xacro:student_chair name="chair_c1_r2" x="-4.5" y="-1.18" yaw="3.14"/>
    <xacro:student_chair name="chair_c1_r3" x="-4.5" y="-2.98" yaw="3.14"/>
    <xacro:student_chair name="chair_c1_r4" x="-4.5" y="-4.78" yaw="3.14"/>
    <xacro:student_chair name="chair_c2_r1" x="0.0" y="0.62" yaw="3.14"/>
    <xacro:student_chair name="chair_c2_r2" x="0.0" y="-1.18" yaw="3.14"/>
    <xacro:student_chair name="chair_c2_r3" x="0.0" y="-2.98" yaw="3.14"/>
    <xacro:student_chair name="chair_c2_r4" x="0.0" y="-4.78" yaw="3.14"/>
    <xacro:student_chair name="chair_c3_r1" x="4.5" y="0.62" yaw="3.14"/>
    <xacro:student_chair name="chair_c3_r2" x="4.5" y="-1.18" yaw="3.14"/>
    <xacro:student_chair name="chair_c3_r3" x="4.5" y="-2.98" yaw="3.14"/>
    <xacro:student_chair name="chair_c3_r4" x="4.5" y="-4.78" yaw="3.14"/>

    <!-- Tall side cabinets and bookshelves create 3D occlusions and narrow
         side aisles without blocking the central paths. -->
    <xacro:macro name="cabinet" params="name x y yaw h">
      <model name="${name}">
        <static>true</static>
        <link name="cabinet">
          <collision name="body"><pose>0 0 ${h/2} 0 0 0</pose><geometry><box><size>0.55 1.60 ${h}</size></box></geometry></collision>
          <visual name="body_vis"><pose>0 0 ${h/2} 0 0 0</pose><geometry><box><size>0.55 1.60 ${h}</size></box></geometry>
            <material><ambient>0.30 0.36 0.42 1</ambient><diffuse>0.30 0.36 0.42 1</diffuse></material></visual>
        </link>
        <pose>${x} ${y} 0 0 0 ${yaw}</pose>
      </model>
    </xacro:macro>

    <xacro:cabinet name="cabinet_west_north" x="-7.45" y="2.0" yaw="0" h="1.9"/>
    <xacro:cabinet name="cabinet_west_south" x="-7.45" y="-2.0" yaw="0" h="1.9"/>
    <xacro:cabinet name="cabinet_east_north" x="7.45" y="2.0" yaw="3.14" h="1.9"/>
    <xacro:cabinet name="cabinet_east_south" x="7.45" y="-2.0" yaw="3.14" h="1.9"/>

    <model name="reading_table">
      <static>true</static>
      <link name="table">
        <collision name="top"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>1.5 0.9 0.07</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.55 0 0 0</pose><geometry><box><size>1.5 0.9 0.07</size></box></geometry>
          <material><ambient>0.55 0.38 0.20 1</ambient><diffuse>0.55 0.38 0.20 1</diffuse></material></visual>
        <collision name="l1"><pose>-0.62 -0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry></collision>
        <visual name="l1v"><pose>-0.62 -0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="l2"><pose>0.62 -0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry></collision>
        <visual name="l2v"><pose>0.62 -0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="l3"><pose>-0.62 0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry></collision>
        <visual name="l3v"><pose>-0.62 0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
        <collision name="l4"><pose>0.62 0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry></collision>
        <visual name="l4v"><pose>0.62 0.36 0.27 0 0 0</pose><geometry><box><size>0.07 0.07 0.54</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
      </link>
      <pose>-6.1 -4.9 0 0 0 0</pose>
    </model>
  </world>
</sdf>