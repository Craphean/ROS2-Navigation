# Unified ROS 2 Lyrical container for both RTX 5090 headless simulation / benchmarks
# and physical 3D-LiDAR robot onboard Linux deployment.
#
# Build:
#   docker build -f docker/Dockerfile.ros2 -t lite-hmre:lyrical .
# Edge-compute benchmark run (4 CPU cores / 8 GB RAM):
#   docker run --rm --cpus=4 --memory=8g -v "$PWD":/ws lite-hmre:lyrical ...

ARG BASE_IMAGE=osrf/ros:lyrical-desktop
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    ROS_DISTRO=lyrical \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      cmake \
      git \
      pciutils \
      psmisc \
      python3-colcon-common-extensions \
      python3-pip \
      python3-pytest \
      python3-rosdep \
      python3-venv \
      libeigen3-dev \
      libopencv-dev \
      pybind11-dev \
      ros-lyrical-navigation2 \
      ros-lyrical-nav2-bringup \
      ros-lyrical-slam-toolbox \
      ros-lyrical-robot-localization \
      ros-lyrical-pointcloud-to-laserscan \
      ros-lyrical-octomap-server \
      ros-lyrical-octomap-msgs \
      ros-lyrical-rmw-cyclonedds-cpp \
      ros-lyrical-nav2-minimal-tb3-sim \
      ros-lyrical-nav2-minimal-tb4-sim \
      ros-lyrical-xacro \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ws

COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements-dev.txt \
    && rm -f /tmp/requirements-dev.txt

COPY docker/entrypoint.sh /ros_entrypoint.sh
RUN chmod +x /ros_entrypoint.sh

ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
